# Copy this file to .env and set a long, unique upload password.
PORT=3000
BASE_URL=http://localhost:3000
UPLOAD_PASSWORD=Sakshi@2504
# Optional cloud configuration. If both are set, uploaded files and metadata use AWS and MongoDB.
AWS_REGION=ap-south-1
S3_BUCKET=
MONGODB_URI=
MONGODB_DB=secure_file_sharing
# Optional: use a custom S3-compatible endpoint only for local development/testing.
S3_ENDPOINT=

