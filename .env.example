# Local demo owner password
UPLOAD_PASSWORD=choose-a-long-password
# Set this to the public HTTPS URL after deployment
APP_BASE_URL=http://localhost:8501

# AWS S3 (leave S3_BUCKET blank for local demo)
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional credentials; preferably use an IAM role when available
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# MongoDB Atlas (leave MONGODB_URI blank for local demo)
MONGODB_URI=
MONGODB_DB=secure_file_sharing

